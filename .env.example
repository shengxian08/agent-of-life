# ============================================================
# Agent of Life v4.0 - Environment Configuration
# Copy this to .env and fill in your values
# ⚠️  .env 文件不要提交到 Git！
# ============================================================

# DeepSeek API (OpenAI 兼容)
OPENAI_API_KEY=sk-your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# Embedding (BGE-M3 中文优化, 1024维)
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# Reranker (BGE-Reranker-v2 精排)
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
USE_RERANKER=true

# Hybrid Retrieval
RETRIEVAL_TOP_K=20
FINAL_TOP_K=5
HYBRID_ALPHA=0.7

# Redis (short-term memory)
REDIS_URL=redis://localhost:6379/0

# Database (SQLite for dev, MySQL for production)
DATABASE_URL=sqlite+aiosqlite:///./data/household.db

# ChromaDB (vector store)
CHROMA_PERSIST_DIR=./data/chroma

# LangGraph Checkpointer (SQLite)
CHECKPOINT_DB_PATH=./data/checkpoints.db

# App Settings
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=INFO

# JWT (for future auth)
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
JWT_ALGORITHM=HS256

# Agent Settings
AGENT_MAX_ITERATIONS=10
AGENT_PARALLEL_TOOLS=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# CORS (生产环境限制为具体域名)
CORS_ALLOWED_ORIGINS=*

# Household Settings
ELECTRICITY_OFF_PEAK_START=22:00
ELECTRICITY_OFF_PEAK_END=06:00
DEFAULT_CITY=北京
DEFAULT_LOCATION=朝阳区

# HuggingFace (国内用户使用镜像站)
# HF_ENDPOINT=https://hf-mirror.com
# HF_HOME=./data/models/huggingface
