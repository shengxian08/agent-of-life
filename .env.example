# DeepSeek API (必填，文字对话)
OPENAI_API_KEY=sk-your-deepseek-key
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 视觉识别 (可选，拍照识食材)
# 推荐千问 VL：https://dashscope.console.aliyun.com
VISION_ENABLED=true
VISION_MODEL=qwen-vl-plus
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=sk-your-aliyun-key

# 快递100 (可选，启用真实快递追踪，免费100次/天)
# 注册地址：https://api.kuaidi100.com
# KUAIDI100_CUSTOMER=your-customer-id
# KUAIDI100_KEY=your-api-key

# 日志级别 (可选)
LOG_LEVEL=INFO

# RAG 增强 (可选，开启后使用 HyDE 假设文档提升召回)
RETRIEVAL_USE_HYDE=true
RETRIEVAL_MIN_DENSE_SCORE=0.35
